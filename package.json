{
  "name": "sec-term",
  "version": "1.1.0",
  "description": "High-fidelity terminal secrets manager for AWS SSM Parameter Store & local zero-cloud encrypted vaults supporting instant .env export, multi-target drift diffing, and zero-disk in-memory secret injection.",
  "keywords": [
    "aws",
    "ssm",
    "parameter-store",
    "secrets-manager",
    "dotenv",
    "secrets",
    "env-diff",
    "cli",
    "developer-tools",
    "devops"
  ],
  "author": "authoritydmc",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authoritydmc/sec-term.git"
  },
  "bugs": {
    "url": "https://github.com/authoritydmc/sec-term/issues"
  },
  "homepage": "https://github.com/authoritydmc/sec-term#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "sec-term": "./dist/cli.js",
    "secx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "tsx --test src/test/sec-term.test.ts",
    "lint": "eslint src/ --ext .ts",
    "prepublishOnly": "npm run build && npm test",
    "release:patch": "npm version patch && git push origin main --follow-tags",
    "release:minor": "npm version minor && git push origin main --follow-tags",
    "release:major": "npm version major && git push origin main --follow-tags"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.658.0",
    "@aws-sdk/client-ssm": "^3.658.0",
    "commander": "^12.1.0",
    "picocolors": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.2.4",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
